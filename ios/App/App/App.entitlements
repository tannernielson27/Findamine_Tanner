<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Xcode signs App Store / TestFlight builds
	     with "production" automatically; "development" is for Xcode runs.
	     Universal links (optional, see docs/ios-build-on-mac.md) would add:
	     <key>com.apple.developer.associated-domains</key>
	     <array><string>applinks:findamine.app</string></array> -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
