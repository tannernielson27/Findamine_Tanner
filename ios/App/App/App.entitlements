<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Xcode signs App Store / TestFlight builds
	     with "production" automatically; "development" is for Xcode runs. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: emailed confirm / reset links (and any other site link)
	     open in the app instead of Safari. Each host serves
	     /.well-known/apple-app-site-association (src/lib/native/universal-links.ts).
	     Only hosts that serve the file directly: www.findamine.app redirects to
	     findamine.app, and iOS does not follow redirects for it. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:findamine-tanner.vercel.app</string>
		<string>applinks:findamine.app</string>
	</array>
</dict>
</plist>
